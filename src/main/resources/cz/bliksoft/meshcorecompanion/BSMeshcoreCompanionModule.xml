<?xml version="1.0" encoding="UTF-8"?>
<root xmlns="http://bliksoft.cz/XmlFilesystem"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://bliksoft.cz/XmlFilesystem https://bliksoft.cz/schemas/XmlFilesystem.xsd">

	<file name="core">
		<file name="ui">
		<attribute name="main" value="main" />
		<file name="main" type="UIPane">
			<attribute name="theme" value="system" />
			<attribute name="title" value="BSMeshcoreCompanion" />
			<attribute name="iconBase" value="/icons/mesh.svg|${size}|||add8e6" />
			<attribute name="minWidth" value="800" />
			<attribute name="minHeight" value="500" />

			<file name="topbar" type="VBox">
				<attribute name="spacing" value="0" />
				<attribute name="region" value="top" />
				<file name="toolbar" type="HBox" id="toolbar">
					<attribute name="spacing" value="0" />
					<file name="left" type="HBox" id="toolbar/left">
						<attribute name="FXclass" value="tool-bar" />
						<attribute name="hgrow" value="ALWAYS" />
						<attribute name="maxHeight" value="max" />
					</file>
					<file name="right" type="HBox" id="toolbar/right">
						<attribute name="FXclass" value="tool-bar" />
						<attribute name="maxHeight" value="max" />
						<file name="Advert" type="Class">
							<attribute name="class" value="cz.bliksoft.meshcorecompanion.actions.AdvertMenuButton" />
						</file>
						<file name="Connect" type="Button">
							<attribute name="action" value="ConnectAction" />
							<attribute name="focusTraversable" value="false" />
						</file>
						<file name="Disconnect" type="Button">
							<attribute name="action" value="DisconnectAction" />
							<attribute name="focusTraversable" value="false" />
						</file>
						<file name="Settings" type="Button">
							<attribute name="action" value="OpenSettingsAction" />
							<attribute name="focusTraversable" value="false" />
						</file>
						<file name="Save" type="Button">
							<attribute name="action" value="Save" />
							<attribute name="focusTraversable" value="false" />
						</file>
						<file name="Close" type="Button">
							<attribute name="action" value="Close" />
							<attribute name="focusTraversable" value="false" />
						</file>
						<file name="AppClose" type="Button">
							<attribute name="action" value="AppClose" />
							<attribute name="focusTraversable" value="false" />
						</file>
					</file>
				</file>
			</file>

			<file name="statusbar" type="HBox" id="statusbar">
				<attribute name="spacing" value="0" />
				<attribute name="region" value="bottom" />
				<attribute name="FXclass" value="bevel-raised" />
				<file name="connectionStatus" type="Class">
					<attribute name="class"
						value="cz.bliksoft.meshcorecompanion.controls.ConnectionStatusLabel" />
					<attribute name="FXclass" value="bevel-lowered" />
				</file>
				<file name="filler" type="StackPane">
					<attribute name="hgrow" value="SOMETIMES" />
				</file>
				<file name="contactsCount" type="Class">
					<attribute name="class" value="cz.bliksoft.meshcorecompanion.controls.ContactsCountLabel" />
					<attribute name="FXclass" value="bevel-lowered" />
				</file>
				<file name="groupsCount" type="Class">
					<attribute name="class" value="cz.bliksoft.meshcorecompanion.controls.GroupsCountLabel" />
					<attribute name="FXclass" value="bevel-lowered" />
				</file>
				<file name="statusbarMessage" type="Class">
					<attribute name="class"
						value="cz.bliksoft.javautils.app.ui.components.MessageStatusProvider" />
					<attribute name="FXclass" value="bevel-lowered" />
				</file>
			</file>
		</file>
		</file>
	</file>

	<file name="core">
		<file name="actions">
			<symlink target-id="action.AppClose" />
			<symlink target-id="action.Save" />
			<symlink target-id="action.Close" />
			<file name="cz.bliksoft.meshcorecompanion.actions.ConnectAction" />
			<file
				name="cz.bliksoft.meshcorecompanion.actions.DisconnectAction" />
			<file
				name="cz.bliksoft.meshcorecompanion.actions.OpenSettingsAction" />
		</file>

		<file name="iconspec">
			<file name="action">
				<file name="settings">
					<attribute name="iconspec">svg/settings.svg|${toolbar-size}|||${stroke-button}</attribute>
					<attribute name="menu-iconspec">svg/settings.svg|${menu-icon-size}|||${stroke-button}</attribute>
				</file>
				<file name="advert">
					<attribute name="iconspec">/icons/advert.svg|${toolbar-size}|||${stroke-button}</attribute>
				</file>
				<file name="connect">
					<attribute name="iconspec">/icons/link.svg|${toolbar-size}|||${stroke-button}</attribute>
				</file>
				<file name="disconnect">
					<attribute name="iconspec">/icons/unlink.svg|${toolbar-size}|||${stroke-button}</attribute>
				</file>
				<file name="usb">
					<attribute name="iconspec">/icons/usb.svg|${button-size}|||${stroke-button}</attribute>
				</file>
				<file name="network">
					<attribute name="iconspec">/icons/network.svg|${button-size}|||${stroke-button}</attribute>
				</file>
				<file name="bluetooth">
					<attribute name="iconspec">/icons/bluetooth.svg|${button-size}|||${stroke-button}</attribute>
				</file>
				<file name="send">
					<attribute name="iconspec">/icons/send.svg|${button-size}|||${stroke-add}</attribute>
				</file>
				<file name="import">
					<attribute name="iconspec">/icons/import.svg|${button-size}|||${stroke-add}</attribute>
				</file>
				<file name="filter">
					<attribute name="iconspec">/icons/filter.svg|${button-size}|||${stroke-button}</attribute>
				</file>
			</file>
			<file name="tab">
				<file name="contact-chats">
					<attribute name="iconspec">/icons/user.svg|${tab-icon-size}|||${stroke-button}</attribute>
				</file>
				<file name="group-chats">
					<attribute name="iconspec">/icons/users.svg|${tab-icon-size}|||${stroke-button}</attribute>
				</file>
				<file name="log">
					<attribute name="iconspec">/icons/log.svg|${tab-icon-size}|||${stroke-button}</attribute>
				</file>
			</file>
		</file>
	</file>

	<include path="config/settings.xml" />

	<!-- About dialog (BSToolbox-jfx HelpAboutPane): application info and the credits of the
	     third-party libraries this application ships beyond those of common-java-utils-jfx
	     (BaseAppModule.xml) and common-java-utils-resources -->
	<file name="core">
		<file name="ui">
			<file name="about">
				<attribute name="description" value="Desktop companion application for MeshCore mesh radios" />
				<attribute name="copyright" value="Jakub Jelínek, © 2026 - GNU Lesser General Public License 2.1" />
				<attribute name="url" value="https://github.com/jelinj8/Java-BSMeshcoreCompanion" />
			</file>
		</file>
	</file>

	<file name="licences">
		<file name="AFL21">
			<attribute name="name" value="Academic Free License 2.1" />
			<attribute name="url" value="https://spdx.org/licenses/AFL-2.1.html" />
		</file>
		<file name="GPL2">
			<attribute name="name" value="GNU General Public License, version 2 or later" />
			<attribute name="url" value="https://www.gnu.org/licenses/old-licenses/gpl-2.0.html" />
		</file>
	</file>

	<file name="lib_credits" sorted="true">
		<file name="jserialcomm">
			<attribute name="name" value="jSerialComm" />
			<attribute name="url" value="https://fazecast.github.io/jSerialComm/" />
			<attribute name="comment" value="serial port access" />
			<attribute name="licence" value="APACHE2,LGPL3" />
		</file>
		<file name="jackson">
			<attribute name="name" value="Jackson" />
			<attribute name="url" value="https://github.com/FasterXML/jackson" />
			<attribute name="comment" value="JSON processing" />
			<attribute name="licence" value="APACHE2" />
		</file>
		<file name="btleplug">
			<attribute name="name" value="btleplug" />
			<attribute name="url" value="https://github.com/deviceplug/btleplug" />
			<attribute name="comment" value="Bluetooth LE library of the BLE bridge (native helper program)" />
			<attribute name="licence" value="MIT,APACHE2,BSD3" />
		</file>
		<file name="rust crates">
			<attribute name="name" value="Rust crates: Tokio, Serde, futures, uuid, dbus-rs, windows-rs" />
			<attribute name="url" value="https://crates.io/" />
			<attribute name="comment" value="Rust libraries of the BLE bridge" />
			<attribute name="licence" value="MIT,APACHE2" />
		</file>
		<file name="libdbus">
			<attribute name="name" value="libdbus (D-Bus)" />
			<attribute name="url" value="https://www.freedesktop.org/wiki/Software/dbus/" />
			<attribute name="comment" value="D-Bus library built into the Linux BLE bridge" />
			<attribute name="licence" value="AFL21,GPL2" />
		</file>
		<file name="bstoolbox-ble">
			<attribute name="name" value="BSToolbox-BLE" />
			<attribute name="url" value="https://github.com/jelinj8/Java-BSToolbox-BLE" />
			<attribute name="comment" value="Bluetooth LE client library (with the native BLE bridge)" />
			<attribute name="licence" value="LGPL21" />
		</file>
		<file name="meshcore">
			<attribute name="name" value="Java-Meshcore" />
			<attribute name="url" value="https://github.com/jelinj8/Java-Meshcore" />
			<attribute name="comment" value="MeshCore companion protocol library" />
			<attribute name="licence" value="LGPL21" />
		</file>
	</file>

</root>
